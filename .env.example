DATABASE_URL=postgresql://user:password@ep-xxx-xxx.aws.neon.tech/agos?sslmode=require

AGOS_MODEL_DIR=./backend/models
AGOS_UPLOAD_DIR=./backend/uploads
AGOS_MAX_UPLOAD_BYTES=10485760

# Auth bridge: must match the value in frontend/.env.local (32+ chars).
AGOS_INTERNAL_SECRET=replace-with-a-random-32-character-secret

# Local development only. Keep 0 in production so requests require a token.
AGOS_ALLOW_DEV_USER=0
AGOS_DEV_USER_EMAIL=dev@local
AGOS_CORS_ORIGINS=http://localhost:3000

# Humanization (install backend/requirements-llm.txt first).
AGOS_HUMANIZATION_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
AGOS_HUMANIZATION_DEVICE=cpu
AGOS_HUMANIZATION_MAX_TOKENS=160

# Frontend values belong in frontend/.env.local, not here:
# AUTH_SECRET=
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AGOS_API_URL=http://127.0.0.1:8000
