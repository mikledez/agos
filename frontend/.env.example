# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Must match backend AGOS_INTERNAL_SECRET.
AGOS_INTERNAL_SECRET=replace-with-a-random-32-character-secret

# Where the FastAPI service runs (server-side only).
AGOS_API_URL=http://127.0.0.1:8000

# Optional: show a credentials form for local development without Google.
# AUTH_DEV_LOGIN=0
